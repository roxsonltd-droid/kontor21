generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  TRADER
  ORACLE
  ADMIN
  LAB
  INSPECTOR
}

enum OperationalStatus {
  PENDING
  SHIPPED
  INSPECTED
  CONDITIONS_SATISFIED
  DISPUTED
}

enum SettlementStatus {
  AWAITING_FUNDS
  FUNDED
  RELEASED
  REFUNDED
  PARTIAL_SETTLEMENT
  DISPUTED
}

enum ProviderRole {
  ORACLE
  LAB
  INSPECTOR
  CARRIER
}

enum ConditionOperator {
  LTE @map("<=")
  GTE @map(">=")
  LT  @map("<")
  GT  @map(">")
  EQ  @map("==")
}

enum EvidenceValidationStatus {
  PENDING
  VALID
  INVALID
  CONFLICTING
  EXPIRED
  REVOKED
  MANUAL_REVIEW
}

model User {
  id            String   @id @default(uuid())
  walletAddress String   @unique
  companyName   String?
  vatNumber     String?  // ЕИК/VAT
  role          UserRole @default(TRADER)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  // Relations
  tradesAsBuyer  TradeMetadata[] @relation("BuyerTrades")
  tradesAsSeller TradeMetadata[] @relation("SellerTrades")
  tradesAsOracle TradeMetadata[] @relation("OracleTrades")

  @@index([role])
}

model TradeMetadata {
  id                   String   @id @default(uuid())
  blockchainTradeId    Int?     @unique // ID from the smart contract
  productName          String
  quantity             Decimal  @db.Decimal(20, 6) // Nexus Core: High precision for commodities
  unit                 String   // e.g. "tons", "kg"
  priceUsdc            Decimal  @db.Decimal(20, 6) // Nexus Core: High precision for crypto-dollars
  
  buyerId  String
  sellerId String
  buyer    User @relation("BuyerTrades", fields: [buyerId], references: [id])
  seller   User @relation("SellerTrades", fields: [sellerId], references: [id])

  oracleId String?
  oracle   User? @relation("OracleTrades", fields: [oracleId], references: [id])

  // Nexus Core: Separation of physical state and financial state
  operationalStatus OperationalStatus @default(PENDING)
  settlementStatus  SettlementStatus  @default(AWAITING_FUNDS)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  conditions  TradeCondition[]
  evidence    Evidence[]
  auditLogs   AuditLog[]

  @@index([buyerId])
  @@index([sellerId])
  @@index([oracleId])
}

// Nexus Core: Structured Rules Engine Inputs
model TradeCondition {
  id           String   @id @default(uuid())
  tradeId      String
  parameter    String   // e.g. "moisture", "location", "weight"
  operator     ConditionOperator
  value        String   // e.g. "8.0", "Hamad Port"
  unit         String?  // e.g. "%", "tons"
  providerRole ProviderRole
  isRequired   Boolean  @default(true)
  
  trade        TradeMetadata @relation(fields: [tradeId], references: [id])
  evidence     Evidence[]

  @@index([tradeId])
}

// Nexus Core: Verifiable Credentials / Lab Results
model Evidence {
  id             String   @id @default(uuid())
  tradeId        String
  conditionId    String?  // Which condition this evidence satisfies
  documentHash   String   // IPFS hash of the actual PDF/Cert
  providerWallet String   // Who uploaded it (e.g. SGS Oracle)
  verifiedValue  String?  // The extracted value (e.g. "4.8" for moisture)
  validationStatus EvidenceValidationStatus @default(PENDING)
  createdAt      DateTime @default(now())

  trade     TradeMetadata   @relation(fields: [tradeId], references: [id])
  condition TradeCondition? @relation(fields: [conditionId], references: [id])

  @@index([tradeId])
  @@index([conditionId])
}

model AuditLog {
  id              String   @id @default(uuid())
  tradeId         String
  action          String   // e.g., "CERTIFICATE_UPLOADED", "CONDITIONS_SATISFIED"
  actorWallet     String   
  documentIpfsHash String? 
  createdAt       DateTime @default(now())

  trade TradeMetadata @relation(fields: [tradeId], references: [id])

  @@index([tradeId])
}

model AuthNonce {
  id            String    @id @default(uuid())
  walletAddress String
  nonce         String    @unique
  expiresAt     DateTime
  usedAt        DateTime?
  createdAt     DateTime  @default(now())

  @@index([walletAddress, expiresAt])
}
