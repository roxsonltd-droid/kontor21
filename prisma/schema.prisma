generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  TRADER
  ORACLE
  ADMIN
  LAB
  INSPECTOR
}

enum OperationalStatus {
  PENDING
  SHIPPED
  INSPECTED
  CONDITIONS_SATISFIED
  DISPUTED
}

enum SettlementStatus {
  AWAITING_FUNDS
  FUNDED
  RELEASED
  REFUNDED
  PARTIAL_SETTLEMENT
  DISPUTED
}

enum ProviderRole {
  ORACLE
  LAB
  INSPECTOR
  CARRIER
}

enum ConditionOperator {
  LTE @map("<=")
  GTE @map(">=")
  LT  @map("<")
  GT  @map(">")
  EQ  @map("==")
}

enum EvidenceValidationStatus {
  PENDING
  VALID
  INVALID
  CONFLICTING
  EXPIRED
  REVOKED
  MANUAL_REVIEW
}

enum OrganizationRole {
  OWNER
  ADMIN
  TRADER
  ACCOUNTANT
  SIGNER
  VIEWER
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
  REVOKED
}

enum MilestoneStatus {
  DRAFT
  ACTIVE
  EVIDENCE_PENDING
  READY_FOR_RELEASE
  PARTIALLY_RELEASED
  RELEASED
  DISPUTED
  CANCELLED
}

enum MilestoneSettlementStatus {
  PENDING
  PROPOSED
  APPROVED
  EXECUTED
  REFUNDED
  FAILED
}

enum ChainEventProcessingStatus {
  PENDING
  PROCESSED
  FAILED
}

enum ReconciliationIssueStatus {
  OPEN
  RESOLVED
  IGNORED
}

model User {
  id            String   @id @default(uuid())
  walletAddress String   @unique
  companyName   String?
  vatNumber     String?  // ЕИК/VAT
  role          UserRole @default(TRADER)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  // Relations
  tradesAsBuyer  TradeMetadata[] @relation("BuyerTrades")
  tradesAsSeller TradeMetadata[] @relation("SellerTrades")
  tradesAsOracle TradeMetadata[] @relation("OracleTrades")
  memberships    OrganizationMembership[]

  @@index([role])
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  vatNumber String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships    OrganizationMembership[]
  tradesAsBuyer  TradeMetadata[] @relation("BuyerOrganizationTrades")
  tradesAsSeller TradeMetadata[] @relation("SellerOrganizationTrades")
}

model OrganizationMembership {
  id             String           @id @default(uuid())
  organizationId String
  userId         String
  role           OrganizationRole
  status         MembershipStatus @default(ACTIVE)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId, status])
  @@index([organizationId, role, status])
}

model TradeMetadata {
  id                   String   @id @default(uuid())
  blockchainTradeId    Int?     @unique // ID from the smart contract
  productName          String
  quantity             Decimal  @db.Decimal(20, 6) // Nexus Core: High precision for commodities
  unit                 String   // e.g. "tons", "kg"
  priceUsdc            Decimal  @db.Decimal(20, 6) // Nexus Core: High precision for crypto-dollars
  
  buyerId  String
  sellerId String
  buyer    User @relation("BuyerTrades", fields: [buyerId], references: [id])
  seller   User @relation("SellerTrades", fields: [sellerId], references: [id])

  oracleId String?
  oracle   User? @relation("OracleTrades", fields: [oracleId], references: [id])

  buyerOrganizationId  String?
  sellerOrganizationId String?
  buyerOrganization    Organization? @relation("BuyerOrganizationTrades", fields: [buyerOrganizationId], references: [id])
  sellerOrganization   Organization? @relation("SellerOrganizationTrades", fields: [sellerOrganizationId], references: [id])

  // Nexus Core: Separation of physical state and financial state
  operationalStatus OperationalStatus @default(PENDING)
  settlementStatus  SettlementStatus  @default(AWAITING_FUNDS)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  conditions  TradeCondition[]
  evidence    Evidence[]
  auditLogs   AuditLog[]
  milestones  TradeMilestone[]

  @@index([buyerId])
  @@index([sellerId])
  @@index([oracleId])
  @@index([buyerOrganizationId])
  @@index([sellerOrganizationId])
}

model TradeMilestone {
  id              String          @id @default(uuid())
  tradeId         String
  sequence        Int
  title           String
  description     String?
  amountUsdc      Decimal         @db.Decimal(20, 6)
  status          MilestoneStatus @default(DRAFT)
  evidenceDueAt   DateTime?
  acceptanceDueAt DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  trade       TradeMetadata        @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  conditions  TradeCondition[]
  evidence    Evidence[]
  settlements MilestoneSettlement[]

  @@unique([tradeId, sequence])
  @@index([tradeId, status])
}

model MilestoneSettlement {
  id              String                    @id @default(uuid())
  milestoneId     String
  amountUsdc      Decimal                   @db.Decimal(20, 6)
  status          MilestoneSettlementStatus @default(PENDING)
  evidenceRoot    String?
  transactionHash String?                   @unique
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  milestone TradeMilestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)

  @@index([milestoneId, status])
}

// Nexus Core: Structured Rules Engine Inputs
model TradeCondition {
  id           String   @id @default(uuid())
  tradeId      String
  parameter    String   // e.g. "moisture", "location", "weight"
  operator     ConditionOperator
  value        String   // e.g. "8.0", "Hamad Port"
  unit         String?  // e.g. "%", "tons"
  providerRole ProviderRole
  isRequired   Boolean  @default(true)
  milestoneId  String?
  
  trade        TradeMetadata @relation(fields: [tradeId], references: [id])
  evidence     Evidence[]
  milestone    TradeMilestone? @relation(fields: [milestoneId], references: [id], onDelete: Cascade)

  @@index([tradeId])
  @@index([milestoneId])
}

// Nexus Core: Verifiable Credentials / Lab Results
model Evidence {
  id             String   @id @default(uuid())
  tradeId        String
  conditionId    String?  // Which condition this evidence satisfies
  documentHash   String   // IPFS hash of the actual PDF/Cert
  providerWallet String   // Who uploaded it (e.g. SGS Oracle)
  verifiedValue  String?  // The extracted value (e.g. "4.8" for moisture)
  validationStatus EvidenceValidationStatus @default(PENDING)
  milestoneId     String?
  createdAt      DateTime @default(now())

  trade     TradeMetadata   @relation(fields: [tradeId], references: [id])
  condition TradeCondition? @relation(fields: [conditionId], references: [id])
  milestone TradeMilestone? @relation(fields: [milestoneId], references: [id], onDelete: Cascade)

  @@index([tradeId])
  @@index([conditionId])
  @@index([milestoneId])
}

model AuditLog {
  id              String   @id @default(uuid())
  tradeId         String
  action          String   // e.g., "CERTIFICATE_UPLOADED", "CONDITIONS_SATISFIED"
  actorWallet     String   
  documentIpfsHash String? 
  createdAt       DateTime @default(now())

  trade TradeMetadata @relation(fields: [tradeId], references: [id])

  @@index([tradeId])
}

model AuthNonce {
  id            String    @id @default(uuid())
  walletAddress String
  nonce         String    @unique
  expiresAt     DateTime
  usedAt        DateTime?
  createdAt     DateTime  @default(now())

  @@index([walletAddress, expiresAt])
}

model ChainCursor {
  id                 String   @id @default(uuid())
  network            String
  contractAddress    String
  lastProcessedBlock BigInt
  confirmations      Int
  updatedAt          DateTime @updatedAt

  @@unique([network, contractAddress])
}

model ChainEvent {
  id              String                     @id @default(uuid())
  network         String
  contractAddress String
  blockNumber     BigInt
  transactionHash String
  logIndex        Int
  eventName       String
  payload         Json
  status          ChainEventProcessingStatus @default(PENDING)
  processedAt     DateTime?
  errorMessage    String?
  createdAt       DateTime                   @default(now())

  deadLetter DeadLetterEvent?

  @@unique([network, contractAddress, transactionHash, logIndex])
  @@index([network, contractAddress, blockNumber])
  @@index([status, createdAt])
}

model DeadLetterEvent {
  id           String   @id @default(uuid())
  chainEventId String   @unique
  retryCount   Int      @default(0)
  lastError    String
  nextRetryAt  DateTime?
  resolvedAt   DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  chainEvent ChainEvent @relation(fields: [chainEventId], references: [id], onDelete: Cascade)

  @@index([resolvedAt, nextRetryAt])
}

model ReconciliationIssue {
  id              String                    @id @default(uuid())
  network         String
  contractAddress String
  tradeId         String?
  blockchainTradeId Int
  field           String
  databaseValue   String?
  chainValue      String
  status          ReconciliationIssueStatus @default(OPEN)
  detectedAt      DateTime                  @default(now())
  resolvedAt      DateTime?
  details         Json?

  @@index([status, detectedAt])
  @@index([blockchainTradeId, status])
}

model RateLimitBucket {
  id          String   @id @default(uuid())
  key         String
  windowStart DateTime
  count       Int      @default(0)
  expiresAt   DateTime

  @@unique([key, windowStart])
  @@index([expiresAt])
}
