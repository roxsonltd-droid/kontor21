generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id            String   @id @default(uuid())
  walletAddress String   @unique
  companyName   String?
  vatNumber     String?  // ЕИК/VAT
  role          String   @default("TRADER") // TRADER, ORACLE, ADMIN
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  // Relations
  tradesAsBuyer  TradeMetadata[] @relation("BuyerTrades")
  tradesAsSeller TradeMetadata[] @relation("SellerTrades")
}

model TradeMetadata {
  id                   String   @id @default(uuid())
  blockchainTradeId    Int?     @unique // ID from the smart contract
  productName          String
  quantity             Float
  unit                 String   // e.g. "tons", "kg"
  priceUsdc            Float
  conditionDescription String?
  
  buyerId  String
  sellerId String
  buyer    User @relation("BuyerTrades", fields: [buyerId], references: [id])
  seller   User @relation("SellerTrades", fields: [sellerId], references: [id])

  status      String   @default("PENDING") // PENDING, IN_TRANSIT, COMPLETED, DISPUTED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  auditLogs   AuditLog[]
}

model AuditLog {
  id              String   @id @default(uuid())
  tradeId         String
  action          String   // e.g., "CERTIFICATE_UPLOADED", "FUNDS_LOCKED", "DISPUTE_RAISED"
  actorWallet     String   // The wallet that performed the action
  documentIpfsHash String? // If a document was uploaded
  createdAt       DateTime @default(now())

  trade TradeMetadata @relation(fields: [tradeId], references: [id])
}
